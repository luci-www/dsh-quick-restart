{
  "name": "dsh-quick-restart",
  "version": "0.4.8",
  "description": "One-click restart and one-click plugin control for DeepSeek Harness (Windows): a restart icon beside the sidebar wordmark that asks for confirmation, then force-closes the app and relaunches it outside its job object in ~2 seconds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luci-www/dsh-quick-restart.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "restart",
    "plugin",
    "plugin-manager"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
